{
  "name": "openclaw-skills-doctor",
  "version": "0.3.6",
  "description": "Audit the skills OpenClaw loads: per-step token cost, shadowed duplicates, broken references. CLI + MCP server + native plugin + a bundled skill.",
  "type": "module",
  "bin": {
    "openclaw-skills-doctor": "./bin/openclaw-skills-doctor.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./paths": "./src/paths.mjs",
    "./config": "./src/config.mjs",
    "./install": "./src/install.mjs",
    "./tool": "./src/tool.mjs"
  },
  "openclaw": {
    "extensions": ["./src/openclaw-plugin.mjs"],
    "plugin": {
      "id": "openclaw-skills-doctor",
      "label": "OpenClaw Skills Doctor"
    },
    "compat": {
      "pluginApi": ">=2026.10.9",
      "minGatewayVersion": "2026.10.9"
    },
    "build": {
      "openclawVersion": "2026.10.9",
      "pluginSdkVersion": "2026.10.9"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.9"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/openclaw.test.mjs",
    "plugin:validate": "node scripts/validate-plugin.mjs",
    "prepublishOnly": "node test/openclaw.test.mjs && node scripts/validate-plugin.mjs"
  },
  "dependencies": {
    "opencode-skills-doctor": "^0.9.4"
  },
  "keywords": [
    "openclaw",
    "skills",
    "agent-skills",
    "mcp",
    "audit",
    "tokens",
    "token-budget"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wangyuchen5110/openclaw-skills-doctor.git"
  },
  "homepage": "https://github.com/wangyuchen5110/openclaw-skills-doctor#readme",
  "bugs": {
    "url": "https://github.com/wangyuchen5110/openclaw-skills-doctor/issues"
  },
  "license": "MIT"
}
